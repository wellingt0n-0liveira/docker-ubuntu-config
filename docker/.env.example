# ==========================================
# Variáveis do Banco de Dados (MariaDB)
# ==========================================
# Defina uma senha forte para o root do banco
MYSQL_ROOT_PASSWORD=AltereParaUmaSenhaRootForte123!
# Nome do banco que o BookStack vai usar
MYSQL_DATABASE=bookstackapp
# Usuário e senha que o BookStack usará para se conectar
MYSQL_USER=bookstack_user
MYSQL_PASSWORD=AltereParaUmaSenhaUserForte456!

# ==========================================
# Variáveis do BookStack
# ==========================================
# A URL final de acesso (deve ser o seu domínio com HTTPS)
APP_URL=https://bookstack.oniromante.com.br

# Gere a chave usando o comando no README.md e cole o resultado aqui
APP_KEY=base64:SuaChaveGeradaAquiComSinalDeIgualNoFinal=

# ==========================================
# Configurações de Rede Docker
# ==========================================
# Nome da rede que conecta o NPM ao BookStack
NETWORK_NAME=homelab_network
